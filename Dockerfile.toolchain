FROM rust:1.93.0-trixie@sha256:bbde3ca426faeebab3eb58b8005d3d6da70607817a14bb92a55c94611d4d905f

COPY rust-toolchain.toml /toolchain/rust-toolchain.toml
WORKDIR /toolchain
RUN rustup show active-toolchain

RUN curl --fail --location --retry 3 \
      https://github.com/near/cargo-near/releases/download/cargo-near-v0.22.0/cargo-near-x86_64-unknown-linux-gnu.tar.gz \
      --output /tmp/cargo-near.tar.gz \
    && echo "9429064e30a427e96523f539cb255f3688d2345e5000d7d4e4873a8247247d1a  /tmp/cargo-near.tar.gz" | sha256sum --check \
    && tar -xzf /tmp/cargo-near.tar.gz -C /tmp \
    && install /tmp/cargo-near-x86_64-unknown-linux-gnu/cargo-near /usr/local/cargo/bin/cargo-near \
    && rm -rf /tmp/cargo-near.tar.gz /tmp/cargo-near-x86_64-unknown-linux-gnu

WORKDIR /workspace
