# Copy to .env.v2 in the application root. These are PUBLIC settings, not keys.
# For the FIRST creation of a NEW empty projection only, set this to true.
# Set it back to false once the reader has initialized. Existing DBs are reused.
V2_CREATE_NEW_PROJECTION=false

# Local smoke defaults. Remote visitors require public mode and real HTTPS origins.
V2_RELEASE_TARGET=local
V2_WORKER_URL=http://127.0.0.1:3011
V2_FRONTEND_ORIGIN=http://127.0.0.1:4201

# Public example (replace both hostnames, then rebuild the web image):
# V2_RELEASE_TARGET=public
# V2_WORKER_URL=https://api.YOUR-EXISTING-DOMAIN
# V2_FRONTEND_ORIGIN=https://YOUR-PROJECT.pages.dev
# Or use your tunnel's frontend HTTPS origin when hosting web on OMV7.
