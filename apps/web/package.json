{
  "name": "@bot-bazaar/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/dev-web.mjs",
    "build": "node ../../scripts/write-web-config.mjs && node ../../scripts/check-public-templates.mjs && eslint src ../../packages/shared/src ../../packages/chain/src --max-warnings 0 && ng build",
    "typecheck": "ngc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@bot-bazaar/chain": "workspace:*",
    "@bot-bazaar/shared": "workspace:*",
    "@hot-labs/near-connect": "0.11.4",
    "phaser": "3.90.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.3"
  }
}
