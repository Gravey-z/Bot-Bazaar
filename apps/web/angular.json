{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false,
    "packageManager": "pnpm"
  },
  "projects": {
    "web": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.json",
            "styles": ["src/styles.css"],
            "allowedCommonJsDependencies": ["@hot-labs/near-connect", "phaser"],
            "outputPath": "dist",
            "assets": [
              { "glob": "favicon.svg", "input": "public", "output": "/" },
              { "glob": "config.json", "input": "public", "output": "/" },
              { "glob": "living-town.json", "input": "public", "output": "/" },
              { "glob": "deployment.json", "input": "public", "output": "/" },
              { "glob": "_headers", "input": "public", "output": "/" },
              {
                "glob": "*.json",
                "input": "public/replays",
                "output": "/replays/"
              },
              { "glob": "*.png", "input": "public/art", "output": "/art/" },
              {
                "glob": "*.svg",
                "input": "public/art/living-town",
                "output": "/art/living-town/"
              },
              {
                "glob": "LICENSE.txt",
                "input": "public/art/living-town",
                "output": "/art/living-town/"
              },
              {
                "glob": "**/*",
                "input": "public/art/living-town/game",
                "output": "/art/living-town/game/"
              }
            ]
          },
          "configurations": {
            "production": {
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "sourceMap": true,
              "extractLicenses": false
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "web:build:development",
            "host": "127.0.0.1",
            "port": 4200
          }
        }
      }
    }
  }
}
