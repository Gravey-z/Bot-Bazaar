{
  "name": "bot-bazaar",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": "24.16.0",
    "pnpm": "10.34.7"
  },
  "scripts": {
    "lint": "eslint apps packages scripts tests eslint.config.mjs --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:boundaries": "eslint apps/web/src packages/shared/src packages/chain/src --max-warnings 0",
    "test:boundaries": "node --test tests/boundaries/*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
